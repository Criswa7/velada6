+
+test("serves each outfit photo without a shared CDN cache entry", async () => {
+  const [photoRoute, stateSource] = await Promise.all([
+    readFile(
+      new URL("../app/api/outfit/photo/route.ts", import.meta.url),
+      "utf8",
+    ),
+    readFile(new URL("../app/lib/state.ts", import.meta.url), "utf8"),
+  ]);
+
+  assert.match(
+    photoRoute,
+    /"Netlify-CDN-Cache-Control":\s*"no-store"/,
+  );
+  assert.match(
+    photoRoute,
+    /"Netlify-Vary":\s*"query=participantId\|v\|cacheVersion"/,
+  );
+  assert.doesNotMatch(photoRoute, /max-age=86400,\s*immutable/);
+  assert.match(stateSource, /OUTFIT_PHOTO_CACHE_VERSION\s*=\s*"2"/);
+  assert.match(stateSource, /cacheVersion:\s*OUTFIT_PHOTO_CACHE_VERSION/);
+});
